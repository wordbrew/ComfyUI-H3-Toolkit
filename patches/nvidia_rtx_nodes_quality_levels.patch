+# --- quality levels, enumerated from the SDK then FILTERED BY TEST --------- #
+#
+# The dropdown shipped with four of the seventeen levels in
+# nvvfx.effects.QualityLevel. Five more work; eight do not, and that was
+# established by running each one, not by reading the enum:
+#
+#   LOW..ULTRA              general upscale strength          WORKS
+#   BICUBIC                 plain interpolation               WORKS
+#   HIGHBITRATE_LOW..ULTRA  for already-clean sources         WORKS
+#   DENOISE_LOW..ULTRA      }  NvVFX_Run fails, code -7:
+#   DEBLUR_LOW..ULTRA       }  "invalid parameter value for this effect+selector"
+#
+# QualityLevel is shared across the whole VFX SDK, but this wheel exposes only
+# ONE effect -- effects.VideoSuperRes -- so the denoise and deblur levels belong
+# to effects NVIDIA has not shipped here. They enumerate fine and fail at run
+# time, which is the worst way to offer an option, so they are excluded.
+#
+# Still enumerated dynamically rather than hardcoded: a level the SDK drops
+# cannot leave a dead entry pointing at a missing attribute, and a level it adds
+# shows up once it is added to _VERIFIED. The four original names stay first and
+# ULTRA stays the default, so a saved workflow keeps its value and its meaning.
+_PREFERRED = ("LOW", "MEDIUM", "HIGH", "ULTRA")
+_VERIFIED = _PREFERRED + ("BICUBIC", "HIGHBITRATE_LOW", "HIGHBITRATE_MEDIUM",
+                          "HIGHBITRATE_HIGH", "HIGHBITRATE_ULTRA")
+
+
+def _quality_levels():
+    members = getattr(nvvfx.effects.QualityLevel, "__members__", {})
+    if not members:
+        return list(_PREFERRED), {n: getattr(nvvfx.effects.QualityLevel, n)
+                                  for n in _PREFERRED}
+    names = [n for n in _VERIFIED if n in members]
+    return names, {n: members[n] for n in names}
+
+
+QUALITY_NAMES, QUALITY_LEVELS = _quality_levels()
+
+
